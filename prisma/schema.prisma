// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  user
}

enum TypeStructure {
  artisan
  entreprise
  association
  micro_entrepreneur
}

enum StatutDevis {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  EXPIRE
  CONVERTI
}

enum StatutFacture {
  BROUILLON
  ENVOYEE
  PARTIELLEMENT_PAYEE
  PAYEE
  EN_RETARD
  ANNULEE
}

enum TypeClient {
  particulier
  entreprise
}

enum MethodePaiement {
  CB
  CHEQUE
  VIREMENT
  ESPECES
}

enum TypeProduitService {
  PRODUIT
  SERVICE
}

enum TypeDocument {
  DEVIS
  FACTURE
}

enum TypeLigne {
  PRODUIT
  SERVICE
  REMISE
}

model Utilisateur {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  mot_de_passe_hash  String
  prenom             String?
  nom                String?
  telephone          String?
  role               Role      @default(user)
  actif              Boolean   @default(true)
  date_creation      DateTime  @default(now())
  derniere_connexion DateTime?

  entreprises   Entreprise[]
  refreshTokens RefreshToken[]

  @@map("utilisateurs")
}

model Pays {
  id       Int    @id @default(autoincrement())
  code_iso String @unique @db.VarChar(3)
  nom      String @db.VarChar(100)
  devise   String @db.VarChar(10)

  entreprises     Entreprise[]
  mentionsLegales MentionLegale[]
  clients         Client[]
  tauxTva         TauxTva[]
  devis           Devis[]
  factures        Facture[]

  @@map("pays")
}

model Entreprise {
  id                 Int            @id @default(autoincrement())
  utilisateur_id     Int
  type_structure     TypeStructure
  nom_entreprise     String?
  matricule_fiscal   String         @unique @db.VarChar(20)
  siret              String?        @unique @db.VarChar(14)
  adresse            String
  code_postal        String?
  ville              String
  pays_id            Int
  representant_legal String?
  logo_url           String?

  utilisateur           Utilisateur            @relation(fields: [utilisateur_id], references: [id])
  pays                  Pays                   @relation(fields: [pays_id], references: [id])
  devis                 Devis[]
  facture               Facture[]
  produits              ProduitService[]
  clients               Client[]
  categories            Categorie[]
  compteursNumerotation CompteurNumerotation[]

  @@map("entreprise")
}

model MentionLegale {
  id      Int    @id @default(autoincrement())
  pays_id Int
  type    String @db.VarChar(50)
  texte   String

  pays Pays @relation(fields: [pays_id], references: [id])

  @@map("mention_legale")
}

model Client {
  id            Int        @id @default(autoincrement())
  entreprise_id Int
  type          TypeClient
  nom           String     @db.VarChar(100)
  prenom        String?    @db.VarChar(100)
  email         String?    @db.VarChar(150)
  telephone     String?    @db.VarChar(20)

  adresse     String?
  code_postal String? @db.VarChar(10)
  ville       String? @db.VarChar(100)
  pays_id     Int

  siret             String? @db.VarChar(14)
  matricule_fiscal  String? @db.VarChar(20)
  adresse_legale    String?
  raison_sociale    String? @db.VarChar(200)

  note          String?
  date_creation DateTime @default(now())

  entreprise Entreprise @relation(fields: [entreprise_id], references: [id], onDelete: Cascade)
  pays       Pays       @relation(fields: [pays_id], references: [id])
  devis      Devis[]
  facture    Facture[]

  @@unique([entreprise_id, siret])
  @@map("client")
}

model Categorie {
  id            Int     @id @default(autoincrement())
  entreprise_id Int
  nom           String  @db.VarChar(100)
  description   String?
  parent_id     Int?

  entreprise Entreprise       @relation(fields: [entreprise_id], references: [id], onDelete: Cascade)
  parent     Categorie?       @relation("CategorieParent", fields: [parent_id], references: [id])
  enfants    Categorie[]      @relation("CategorieParent")
  produits   ProduitService[]

  @@map("categorie")
}

model TauxTva {
  id         Int       @id @default(autoincrement())
  pays_id    Int
  taux       Decimal   @db.Decimal(5, 2)
  libelle    String    @db.VarChar(50)
  date_debut DateTime
  date_fin   DateTime?

  pays            Pays             @relation(fields: [pays_id], references: [id])
  produit_service ProduitService[]

  @@map("taux_tva")
}

model ProduitService {
  id               Int                @id @default(autoincrement())
  entreprise_id    Int
  nom              String             @db.VarChar(150)
  description      String?
  prix_unitaire_ht Decimal            @default(0.00) @db.Decimal(15, 2)
  unite            String             @default("pièce") @db.VarChar(20)
  taux_tva_id      Int
  categorie_id     Int?
  actif            Boolean            @default(true)
  type             TypeProduitService

  entreprise    Entreprise     @relation(fields: [entreprise_id], references: [id], onDelete: Cascade)
  taux_tva      TauxTva        @relation(fields: [taux_tva_id], references: [id])
  categorie     Categorie?     @relation(fields: [categorie_id], references: [id])
  facture_ligne FactureLigne[]
  devis_ligne   DevisLigne[]

  @@map("produit_service")
}

model Devis {
  id                    Int         @id @default(autoincrement())
  entreprise_id         Int
  client_id             Int
  pays_id               Int
  numero                String      @unique @db.VarChar(50)
  date_creation         DateTime    @default(now())
  date_validite         DateTime
  date_conversion_devis DateTime?
  statut                StatutDevis @default(BROUILLON)
  total_ht              Decimal     @default(0.00) @db.Decimal(15, 2)
  total_tva             Decimal     @default(0.00) @db.Decimal(15, 2)
  total_ttc             Decimal     @default(0.00) @db.Decimal(15, 2)
  devise                String      @db.VarChar(10)

  entreprise  Entreprise   @relation(fields: [entreprise_id], references: [id])
  client      Client       @relation(fields: [client_id], references: [id])
  pays        Pays         @relation(fields: [pays_id], references: [id])
  devis_ligne DevisLigne[]
  facture     Facture[]

  @@map("devis")
}

model DevisLigne {
  id               Int       @id @default(autoincrement())
  devis_id         Int
  produit_id       Int?
  description      String
  quantite         Decimal   @db.Decimal(10, 2)
  prix_unitaire_ht Decimal   @db.Decimal(15, 4)
  taux_tva         Decimal   @db.Decimal(5, 2)
  type_ligne       TypeLigne @default(PRODUIT)

  montant_ht  Decimal @default(0.00) @db.Decimal(15, 2)
  montant_tva Decimal @default(0.00) @db.Decimal(15, 2)
  montant_ttc Decimal @default(0.00) @db.Decimal(15, 2)

  devis           Devis           @relation(fields: [devis_id], references: [id], onDelete: Cascade)
  produit_service ProduitService? @relation(fields: [produit_id], references: [id], onDelete: SetNull)

  @@map("devis_ligne")
}

model Facture {
  id             Int              @id @default(autoincrement())
  entreprise_id  Int
  client_id      Int
  pays_id        Int
  devis_id       Int?
  numero         String           @unique @db.VarChar(50)
  date_emission  DateTime         @default(now())
  date_echeance  DateTime
  statut         StatutFacture    @default(BROUILLON)
  total_ht       Decimal          @default(0.00) @db.Decimal(15, 2)
  total_tva      Decimal          @default(0.00) @db.Decimal(15, 2)
  total_ttc      Decimal          @default(0.00) @db.Decimal(15, 2)
  devise         String           @db.VarChar(10)
  mode_paiement  MethodePaiement? // méthode prévue/convenue, distincte du paiement réel
  est_acompte    Boolean          @default(false)

  entreprise         Entreprise     @relation(fields: [entreprise_id], references: [id])
  client             Client         @relation(fields: [client_id], references: [id])
  pays               Pays           @relation(fields: [pays_id], references: [id])
  devis              Devis?         @relation(fields: [devis_id], references: [id])
  facture_ligne      FactureLigne[]
  paiement           Paiement[]
  deductions_acompte FactureLigne[] @relation("FactureAcompteDeduction")

  @@map("facture")
}

model FactureLigne {
  id               Int       @id @default(autoincrement())
  facture_id       Int
  produit_id       Int?
  description      String
  quantite         Decimal   @db.Decimal(10, 2)
  prix_unitaire_ht Decimal   @db.Decimal(15, 4)
  taux_tva         Decimal   @db.Decimal(5, 2)
  type_ligne       TypeLigne @default(PRODUIT)

  montant_ht  Decimal @default(0.00) @db.Decimal(15, 2)
  montant_tva Decimal @default(0.00) @db.Decimal(15, 2)
  montant_ttc Decimal @default(0.00) @db.Decimal(15, 2)

  facture_acompte_id Int?

  facture         Facture         @relation(fields: [facture_id], references: [id], onDelete: Cascade)
  produit_service ProduitService? @relation(fields: [produit_id], references: [id], onDelete: SetNull)
  facture_acompte Facture?        @relation("FactureAcompteDeduction", fields: [facture_acompte_id], references: [id])

  @@map("facture_ligne")
}

model Paiement {
  id            Int             @id @default(autoincrement())
  facture_id    Int
  montant       Decimal         @db.Decimal(15, 2)
  date_paiement DateTime        @default(now())
  methode       MethodePaiement
  reference     String?         @db.VarChar(100)

  facture Facture @relation(fields: [facture_id], references: [id])

  @@map("paiement")
}

model RefreshToken {
  id             Int         @id @default(autoincrement())
  token          String      @unique
  utilisateur_id Int
  utilisateur    Utilisateur @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  expires_at     DateTime
  revoked        Boolean     @default(false)
  revoked_at     DateTime?
  revoked_reason String?
  last_used_at   DateTime?
  user_agent     String?
  ip_address     String?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  @@index([utilisateur_id])
  @@index([token])
  @@index([expires_at])
  @@map("refresh_token")
}

model CompteurNumerotation {
  id             Int          @id @default(autoincrement())
  entreprise_id  Int
  type_document  TypeDocument
  annee          Int
  dernier_numero Int          @default(0)

  entreprise Entreprise @relation(fields: [entreprise_id], references: [id], onDelete: Cascade)

  @@unique([entreprise_id, type_document, annee])
  @@map("compteur_numerotation")
}